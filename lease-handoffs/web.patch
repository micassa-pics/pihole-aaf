diff --git a/lease-handoffs.lp b/lease-handoffs.lp
new file mode 100644
index 0000000..ac53313
--- /dev/null
+++ b/lease-handoffs.lp
@@ -0,0 +1,16 @@
+<?
+if mg.request_info.is_authenticated then
+    local f = io.open('/etc/pihole/lease-handoffs/view.txt', 'r')
+    if f then
+        for line in f:lines() do
+            if line:match('^T %d+$') then
+                mg.write('T ' .. (os.time() - tonumber(line:sub(3))) .. '\n')
+            elseif line:match('^[%d%.]+ [%d%.]+ %d+ %d+$')
+                or line:match('^R [%x:]+ [%d%.]+ %a+$') then
+                mg.write(line .. '\n')
+            end
+        end
+        f:close()
+    end
+end
+?>
