#!/bin/sh /etc/rc.common
START=99
STOP=05
USE_PROCD=1

start_service() {
    # Set these in a root-owned host file. The API URL must name this Pi-hole.
    . /etc/pihole-reservation-guard.conf || return 1
    procd_open_instance
    procd_set_param command /usr/bin/python3 -IB /usr/lib/pihole-lease-handoffs/guard-launch.py "$GUARD_STATE" "$GUARD_IPC" "$GUARD_API" "$GUARD_IDENTITY" $GUARD_ORIGINS
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}

