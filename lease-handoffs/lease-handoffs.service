[Unit]
Description=Track Pi-hole DHCP address handoffs
After=local-fs.target

[Service]
Type=simple
User=pihole-handoffs
Group=pihole
UMask=0077
ExecStart=/usr/bin/python3 -EBs /usr/local/lib/pihole-lease-handoffs/worker.py
BindReadOnlyPaths=/etc/pihole:/config
BindPaths=/var/lib/pihole-lease-handoffs:/state /run/pihole-lease-handoffs:/publish
Environment=HANDOFF_PUBLISH=/publish
ProtectSystem=strict
ReadWritePaths=/state /publish
ProtectHome=true
PrivateNetwork=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
