#!/bin/bash
set -eu
read -ra origins <<< "${HANDOFF_ORIGINS:-}"
origin_args=()
for origin in "${origins[@]}"; do origin_args+=(--web-origin "$origin"); done
uid=${HANDOFF_UID:-64321}
gid=${PIHOLE_GID:-1000}

prepare_admin_access() {
    local address
    local -a addresses
    read -ra addresses <<< "${HANDOFF_ADMIN_CIDRS:-}"
    for address in "${addresses[@]}"; do
        # Restrict the input to IP address syntax before writing Nginx directives.
        [[ $address =~ ^[0-9a-fA-F:.]+(/[0-9]{1,3})?$ ]] || return 1
    done
    install -d -m 0755 /run/awesome-a-fyer || return 1
    (
        umask 022
        printf 'allow 127.0.0.1;\n'
        for address in "${addresses[@]}"; do
            printf 'allow %s;\n' "$address"
        done
        printf 'deny all;\n'
    ) > /run/awesome-a-fyer/nginx-access.conf
}

# Each helper restarts independently. Keep DNS running if a helper fails.
supervise() {
    local name=$1 child
    shift
    child=
    trap 'trap - TERM INT; if [[ -n "$child" ]]; then kill -TERM "$child" 2>/dev/null || :; wait "$child" || :; fi; exit 0' TERM INT
    while true; do
        "$@" & child=$!
        wait "$child" || :
        echo "Pi-hole handoffs: $name exited. Restarting in five seconds." >&2
        sleep 5 & child=$!
        wait "$child"
    done
}
helpers=()
stock=
stop() {
    trap - TERM INT QUIT HUP
    for pid in "${helpers[@]}" ${stock:+"$stock"}; do kill -TERM "$pid" 2>/dev/null || :; done
    wait || :
}
trap 'stop; exit 0' TERM INT QUIT HUP
if mountpoint -q /opt/monitor/state && mountpoint -q /opt/monitor/config &&
    [[ /opt/monitor/state/published -ef /run/pihole-lease-handoffs ]]; then
    supervise monitor env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin chroot /opt/monitor /usr/bin/python3 -IB /app/drop.py "$uid" "$gid" /app/worker.py & helpers+=($!)
else
    echo 'Pi-hole handoffs: monitor mounts are unavailable or do not match' >&2
fi
if [[ -x /opt/guard/usr/bin/python3 ]]; then
    if ((${#origins[@]})) && mountpoint -q /opt/guard/state && mountpoint -q /opt/guard/config &&
        [[ /opt/guard/state -ef /opt/monitor/state && /opt/guard/state/ipc -ef /run/reservation-guard &&
           /opt/guard/state/published -ef /run/pihole-lease-handoffs && /opt/guard/config -ef /etc/pihole ]]; then
        supervise guard env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin chroot /opt/guard /usr/bin/python3 -IB /app/drop.py "$uid" "$gid" /app/guard.py /state /state/ipc/guard.sock http://127.0.0.1:8080/api --config-dir /config "${origin_args[@]}" & helpers+=($!)
    else
        echo 'Pi-hole handoffs: guard needs matching persistent mounts and admin origins' >&2
    fi
    if prepare_admin_access; then
        supervise nginx env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin setpriv --reuid=64322 --regid="$gid" --clear-groups --no-new-privs nginx -e stderr -g 'daemon off;' & helpers+=($!)
    else
        echo 'Pi-hole handoffs: cannot create the admin allowlist; check HANDOFF_ADMIN_CIDRS' >&2
    fi
fi
/usr/bin/start.sh "$@" & stock=$!
status=0
wait "$stock" || status=$?
stock=
stop
exit "$status"
