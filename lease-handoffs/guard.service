[Unit]
Description=Pi-hole reservation write guard
After=network.target

[Service]
User=pihole-handoffs
Group=pihole
UMask=0077
ExecStart=/usr/bin/python3 -EBs /usr/local/lib/pihole-lease-handoffs/guard.py /var/lib/pihole-lease-handoffs /var/lib/pihole-lease-handoffs/ipc/guard.sock http://127.0.0.1:8080/api --view /run/pihole-lease-handoffs/view.txt
Restart=on-failure
NoNewPrivileges=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pihole-lease-handoffs /var/lib/pihole-lease-handoffs/ipc
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

