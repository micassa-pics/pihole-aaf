+// FTL timestamps each ten-minute history bucket at its midpoint.
+function loadLeaseActivity() {
+  $.getJSON(document.body.dataset.apiurl + "/history/clients", { N: 0 })
+    .done(({ history, clients }) => {
+      for (const [ip, client] of Object.entries(clients || {})) {
+        if (client?.name) dnsClientNames.set(ip, client.name);
+      }
+      if (!history?.length || !clients) return;
+      const end = history[history.length - 1].timestamp + 300;
+      const range = {
+        start: end - 24 * 3600, end, width: 3600,
+        fill: utils.getCSSval("queries-other", "background-color"),
+        grid: utils.getCSSval("graphs-grid", "background-color"),
+      };
+      const activity = new Map(Object.keys(clients).map(ip => [ip, { bins: new Array(24).fill(0), range }]));
+      for (const { timestamp, data } of history) {
+        const hour = Math.floor((timestamp - range.start) / range.width);
+        if (hour < 0 || hour >= 24) continue;
+        for (const [ip, count] of Object.entries(data)) {
+          const client = activity.get(ip);
+          if (client) client.bins[hour] += count;
+        }
+      }
+      leaseActivity = activity;
+    })
+    .always(() => {
+      leaseActivity ??= new Map();
+      refreshStaticDetails();
+      dhcpLeasesTable.rows().invalidate("data").draw(false);
+    });
+}
+
+function queryActivityChart(activity) {
+  if (!activity) {
+    const label = leaseActivity ? "No per-IP history available" : "Loading query history";
+    return '<svg class="query-activity-chart" width="120" height="28" role="img" aria-label="' + label +
+      '"><title>' + label + '</title><path d="M0 27.5 H120" stroke="' +
+      utils.getCSSval("graphs-grid", "background-color") + '"/></svg>';
+  }
+  const { bins, range } = activity;
+  const peak = Math.max(...bins);
+  const timeLabel = seconds => moment.unix(seconds).utc().format("YYYY-MM-DD HH:mm:ss");
+  const label = "Query activity in 24 equal intervals from " + timeLabel(range.start) + " to " +
+    timeLabel(range.end) + " UTC. Tallest bar: " + peak + ".";
+  const bars = bins.map((count, i) => {
+    const height = count ? Math.max(1, 27 * count / peak) : 0;
+    const start = range.start + i * range.width;
+    const end = i === bins.length - 1 ? range.end : start + range.width;
+    return '<g><title>' + timeLabel(start) + " to " + timeLabel(end) + " UTC: " + count +
+      '</title><rect x="' + (i * 5) + '" width="5" height="28" fill="transparent"/>' +
+      '<rect x="' + (i * 5) + '" y="' + (27 - height) + '" width="4" height="' + height + '"/></g>';
+  });
+  return '<svg class="query-activity-chart" width="120" height="28" role="img" aria-label="' + label +
+    '" fill="' + range.fill + '"><title>' + label + '</title><path d="M0 27.5 H120" stroke="' +
+    range.grid + '"/>' + bars.join("") + '</svg>';
+}
