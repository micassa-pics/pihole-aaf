+function reservationIP(address) {
+  if (address.includes("/")) return "";
+  if (!address.includes(":")) return utils.validateIPv4(address) ? address : "";
+
+  const bracketed = address.startsWith("[") ? address : "[" + address + "]";
+  if (!/^\[[\da-f:.]+\]$/iu.test(bracketed)) return "";
+  try {
+    return new URL("http://" + bracketed).hostname;
+  } catch {
+    return "";
+  }
+}
+
+function reservationMAC(address) {
+  return utils.validateMAC(address) ? address.toLowerCase().replaceAll("-", ":") : "";
+}
+
+function reservationClientID(value) {
+  return /^(?:[\da-f]{2}:)+[\da-f]{2}$/iu.test(value) ? value.toLowerCase() : "";
+}
+
+function updateStaticLeaseKeys(lines) {
+  if (staticLeaseKeys === null) return;
+
+  const keys = new Set();
+  for (const line of lines) {
+    for (const part of line.split(",").map(token => token.trim())) {
+      const ip = part.startsWith("[") || !part.includes(":") ? reservationIP(part) : "";
+      const mac = reservationMAC(part);
+      const clientID = part.startsWith("id:") ? reservationClientID(part.slice(3)) : "";
+      if (ip) keys.add("ip:" + ip);
+      if (mac) keys.add("mac:" + mac);
+      if (clientID) keys.add("id:" + clientID);
+    }
+  }
+
+  const changed = keys.size !== staticLeaseKeys.size || [...keys].some(key => !staticLeaseKeys.has(key));
+  staticLeaseKeys = keys;
+  if (changed) dhcpLeasesTable?.draw(false);
+}
+
+function hasStaticLease(ip, mac, clientID) {
+  return staticLeaseKeys?.has("ip:" + ip) ||
+    staticLeaseKeys?.has("mac:" + mac) ||
+    staticLeaseKeys?.has("id:" + clientID);
+}
+
+function staticLeaseDraft(lease) {
+  if (staticHostsReadOnly || staticLeaseKeys === null) return null;
+
+  const ipaddr = reservationIP(lease.ip || "");
+  const hwaddr = reservationMAC(lease.hwaddr || "");
+  const clientID = reservationClientID(lease.clientid || "");
+  const hostname = utils.validateHostnameDHCP(lease.name || "") ? lease.name : "";
+  if (!ipaddr || (!hwaddr && !clientID && !hostname)) return null;
+  if (pendingStaticReservation?.ipaddr === ipaddr || hasStaticLease(ipaddr, hwaddr, clientID)) {
+    return null;
+  }
+
+  return { ipaddr, hwaddr, hostname, clientID: hwaddr ? "" : clientID };
 }
 
