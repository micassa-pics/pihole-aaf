+
+function durationSeconds(value) {
+  const match = /^(\d+)([smhdw]?)$/i.exec(value);
+  if (!match) return NaN;
+  return Number(match[1]) * ({ s: 1, m: 60, h: 3600, d: 86400, w: 604800 }[match[2].toLowerCase()] || 1);
+}
+
+function configureLeaseTimes(config) {
+  defaultLeaseTime = config.leaseTime.value;
+  hostLeaseTimes = [];
+  for (const line of config.hosts.value) {
+    const fields = line.toLowerCase().split(",").map(field => field.trim());
+    const duration = fields.find(field => field === "infinite" || Number.isFinite(durationSeconds(field)));
+    if (duration) hostLeaseTimes.push({ fields, duration });
+  }
+}
+
+function updateExpirationBar(row, lease) {
+  const bar = row.querySelector(".lease-expiration");
+  if (!bar) return;
+  const ids = [lease.ip, lease.hwaddr, lease.name, "id:" + lease.clientid]
+    .filter(id => id && id !== "*").map(id => id.toLowerCase());
+  const override = hostLeaseTimes.find(({ fields }) => fields.some(field => ids.includes(field)));
+  const value = override?.duration ?? defaultLeaseTime;
+  const duration = value === "" ? (lease.ip.includes(":") ? 86400 : 3600) : durationSeconds(value);
+  const remaining = lease.expires - Date.now() / 1000;
+  const percent = lease.expires === 0 ? 100 : Math.max(0, Math.min(100, 100 * remaining / duration));
+  const label = lease.expires === 0 ? "Never" : moment.unix(lease.expires).fromNow();
+  bar.setAttribute("aria-label", "Lease expiration: " + label);
+  bar.setAttribute("data-original-title", label);
+  bar.classList.toggle("unknown-duration", !Number.isFinite(percent));
+  bar.firstElementChild.style.width = (Number.isFinite(percent) ? percent : 0) + "%";
+}
