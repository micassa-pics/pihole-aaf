+async function readLeaseGroups() {
+  const api = document.body.dataset.apiurl;
+  const [groups, clients] = await Promise.all([$.getJSON(api + "/groups"), $.getJSON(api + "/clients")]);
+  return { groups: groups.groups, clients: clients.clients };
+}
+
+// Active DHCPv4 leases can inherit a subnet, hardware address, or hostname rule.
+function leaseMembership(lease, data) {
+  const ipv4 = text => /^\d{1,3}(?:\.\d{1,3}){3}$/.test(text)
+    ? text.split(".").reduce((ip, part) => ip * 256 + Number(part), 0) : NaN;
+  const ip = ipv4(lease.ip);
+  let best = null;
+  let bits = -1;
+  for (const client of data.clients) {
+    const [address, prefix = "32"] = client.client.split("/");
+    const width = Number(prefix);
+    const size = 2 ** (32 - width);
+    if (width < 1 || width > 32 || Math.floor(ip / size) !== Math.floor(ipv4(address) / size)) continue;
+    if (width > bits || (width === bits && client.id > best.id)) {
+      best = client;
+      bits = width;
+    }
+  }
+  const match = key => key && data.clients.find(c => c.client.toLowerCase() === key.toLowerCase());
+  best ||= match(lease.ip) || match(lease.hwaddr) || match(lease.name);
+  if (best) return { ids: best.groups, rule: best, exact: best.client === lease.ip || bits === 32 };
+  // The lease API does not report the interface on which DNS requests arrive.
+  return { ids: data.clients.some(c => c.client.startsWith(":")) ? null : [0] };
+}
+
+function groupLabel(group) {
+  return group.name + (group.enabled === false ? " (disabled)" : "");
+}
+
+function renderLeaseGroups(lease, type) {
+  if (!leaseGroupData) return "Unavailable";
+  const { ids } = leaseMembership(lease, leaseGroupData);
+  const names = ids?.map(id => {
+    const group = leaseGroupData.groups.find(g => g.id === id);
+    return group ? groupLabel(group) : "#" + id;
+  }).join(", ");
+  const label = ids ? names || "No groups" : "Check interface rule";
+  return type === "display" ? '<button type="button" class="btn btn-default btn-xs edit-lease-groups" title="Edit groups">' +
+    utils.escapeHtml(label) + '</button>' : label;
+}
+
+function setupLeaseGroups() {
+  let busy = false;
+  let openButton;
+  const refresh = data => {
+    leaseGroupData = data;
+    refreshStaticDetails();
+    dhcpLeasesTable.rows().invalidate("data").draw(false);
+  };
+  readLeaseGroups().then(refresh).catch(() => refresh(null));
+  $("#DHCPLeasesTable, #StaticDHCPTable").on("click", ".edit-lease-groups", function () {
+    if (busy) return;
+    if (openButton) openButton.siblings(".lease-group-editor").remove().end().show();
+    const button = $(this);
+    const row = button.closest("tr");
+    const lease = row.data("reservation") || dhcpLeasesTable.row(row).data();
+    const original = leaseMembership(lease, leaseGroupData);
+    const editor = $(document.getElementById("lease-group-template").content.firstElementChild.cloneNode(true));
+    editor.attr("aria-label", "Groups for " + lease.ip);
+    const status = editor.find("[role=status]");
+    const nameField = editor.find(".lease-group-name");
+    const options = editor.find(".lease-group-options");
+    for (const group of leaseGroupData.groups) {
+      const input = $("<input>", { type: "checkbox", value: group.id }).prop("checked", original.ids?.includes(group.id) || false);
+      $("<div>").append($("<label>").append(input, document.createTextNode(" " + groupLabel(group)))).appendTo(options);
+    }
+    if (!original.ids) status.text("Interface membership is unknown. Choose the groups for this IP.");
+    openButton = button.hide().after(editor);
+    const close = () => {
+      editor.remove();
+      button.show().trigger("focus");
+      openButton = null;
+    };
+    editor.find(".cancel-lease-groups").on("click", close);
+    nameField.trigger("focus");
+    editor.find(".save-lease-groups").on("click", async () => {
+      if (busy) return;
+      busy = true;
+      const ids = options.find("input:checked").map((_, el) => Number(el.value)).get();
+      const name = nameField.val().trim();
+      editor.find(":input").prop("disabled", true);
+      status.text("Saving...");
+      let created = false;
+      try {
+        const current = await readLeaseGroups();
+        const membership = leaseMembership(lease, current);
+        if (JSON.stringify(membership) !== JSON.stringify(original) ||
+            ids.some(id => !current.groups.some(g => g.id === id))) {
+          close();
+          refresh(current);
+          utils.showAlert("warning", "", "Group settings changed", "Reopen the row to review its groups.");
+          return;
+        }
+        if (name) {
+          const find = groups => groups.find(g => g.name.toLowerCase() === name.toLowerCase());
+          let group = find(current.groups);
+          if (!group) {
+            const result = await $.ajax({
+              url: document.body.dataset.apiurl + "/groups", method: "POST", contentType: "application/json",
+              data: JSON.stringify({ name: [name], comment: "", enabled: true }),
+            });
+            created = Boolean(result.processed?.success?.length);
+            group = find((await readLeaseGroups()).groups);
+            if (!group) throw new Error(result.processed?.errors?.[0]?.error || "Could not create the group.");
+          }
+          if (!ids.includes(group.id)) ids.push(group.id);
+        }
+        const client = membership.exact && membership.rule;
+        const payload = { groups: ids, comment: client?.comment || "" };
+        if (!client) payload.client = [lease.ip];
+        const result = await $.ajax({
+          url: document.body.dataset.apiurl + "/clients" + (client ? "/" + encodeURIComponent(client.client) : ""),
+          method: client ? "PUT" : "POST", contentType: "application/json", data: JSON.stringify(payload),
+        });
+        if (!result.processed?.success?.length || result.processed.errors?.length)
+          throw new Error(result.processed?.errors?.[0]?.error || "Pi-hole could not update this client.");
+        close();
+        refresh(null);
+        refresh(await readLeaseGroups());
+      } catch (error) {
+        const message = error.message || error.responseJSON?.error?.message || "Could not read or save client groups.";
+        if (openButton) status.text((created ? "Group created. " : "") + message);
+        else utils.showAlert("error", "", "Reload DHCP to refresh groups", utils.escapeHtml(message));
+      } finally {
+        busy = false;
+        editor.find(":input").prop("disabled", false);
+      }
+    });
+  });
+}
