+function querySource() {
+  const url = new URL(queryAPIURL, document.baseURI);
+  const { upstream } = queryScopes[queryScope];
+  const advancedUpstream = url.searchParams.get("upstream");
+  // Pi-hole represents both scopes as upstream aliases. Keep any explicit
+  // upstream filter and apply the scope locally when they would conflict.
+  if (upstream && !advancedUpstream) url.searchParams.set("upstream", upstream);
+  return {
+    url: url.href,
+    filterLocally: Boolean(upstream && advancedUpstream && upstream !== advancedUpstream),
+    blocked: upstream === "blocklist",
+  };
+}
+
+async function collectQueryRows(request, source, requestId) {
+  const groups = new Map();
+  const rows = [];
+  let page;
+  let start = 0;
+  do {
+    page = await requestQueryPage(source.url, {
+      ...request,
+      start,
+      length: queryBatchSize,
+      order: grouped ? [{ column: 0, dir: "desc" }] : request.order,
+      cursor: page?.cursor,
+    });
+
+    if (requestId !== queryRequestId) return;
+    if (beginningOfTime === null && start === 0) initDateRangePicker(page);
+
+    for (const query of page.queries) {
+      if (source.filterLocally && parseQueryStatus(query).blocked !== source.blocked) continue;
+      if (!grouped) {
+        rows.push(query);
+        continue;
+      }
+
+      const { domain, type, client } = query;
+      const hidden = domain === "hidden" || !client.ip || client.ip === "0.0.0.0";
+      const id = hidden ? Symbol() : JSON.stringify([String(domain).toLowerCase(), type, client.ip]);
+      const existing = groups.get(id);
+      if (existing) {
+        existing.group.count++;
+        existing.group.mixedStatus ||= existing.status !== query.status || existing.cname !== query.cname;
+        existing.group.mixedDNSSEC ||= existing.dnssec !== query.dnssec;
+      } else {
+        groups.set(id, { ...query, group: { count: 1, mixedStatus: false, mixedDNSSEC: false } });
+      }
+    }
+
+    start += page.queries.length;
+  } while (page.queries.length > 0 && start < page.recordsFiltered);
+
+  return grouped ? [...groups.values()] : rows;
+}
+
+function sortQueryGroups(rows, order) {
+  const fields = [
+    row => row.time,
+    row => row.group.mixedStatus ? "Mixed" : row.status,
+    row => row.type,
+    row => String(row.domain).toLowerCase(),
+    row => $.fn.dataTable.ext.type.order["ip-address-pre"](row.client.ip),
+    row => row.group.count,
+  ];
+  return [...rows].sort((a, b) => {
+    for (const { column, dir } of order) {
+      const field = fields[column];
+      if (!field) continue;
+      const left = field(a);
+      const right = field(b);
+      if (left !== right) return (left < right ? -1 : 1) * (dir === "asc" ? 1 : -1);
+    }
+
+    return b.time - a.time;
+  });
+}
+
+async function loadQueryRows(request, callback) {
+  const id = ++queryRequestId;
+  queryRequest?.abort();
+  const status = $("#query-view-status");
+  status.text("");
+
+  try {
+    const source = querySource();
+    if (grouped || source.filterLocally) {
+      const key = JSON.stringify([source.url, queryScope, request.search, request.columns, grouped ? null : request.order]);
+      if (querySnapshot?.key !== key) {
+        status.text(grouped ? "Grouping queries…" : "Filtering queries…");
+        const rows = await collectQueryRows(request, source, id);
+        if (id !== queryRequestId) return;
+        querySnapshot = { key, rows };
+      }
+      const rows = grouped ? sortQueryGroups(querySnapshot.rows, request.order) : querySnapshot.rows;
+      status.text("");
+      if (liveMode) utils.setTimer(liveUpdate, REFRESH_INTERVAL.query_log);
+      callback({
+        draw: request.draw,
+        data: rows.slice(request.start, request.start + request.length),
+        recordsTotal: rows.length,
+        recordsFiltered: rows.length,
+      });
+    } else {
+      const response = await requestQueryPage(source.url, { ...request, cursor: cursor ?? undefined });
+      if (id !== queryRequestId) return;
+      cursor = response.cursor;
+      if (beginningOfTime === null) initDateRangePicker(response);
+      if (liveMode) utils.setTimer(liveUpdate, REFRESH_INTERVAL.query_log);
+      callback({ ...response, data: response.queries });
+    }
+  } catch (error) {
+    if (id !== queryRequestId) return;
+    if (grouped) {
+      status.text("Could not group queries. Click Refresh to retry.");
+    } else {
+      alert("Could not load queries." + (error.responseText ? "\n" + error.responseText : ""));
+    }
+
+    callback({ draw: request.draw, data: [], recordsTotal: 0, recordsFiltered: 0 });
+  }
 }
 
