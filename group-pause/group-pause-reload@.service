[Unit]
Description=Run the configured Pi-hole list reload

[Service]
# Socket activation supplies no command arguments. Return OK only on success.
StandardInput=socket
StandardOutput=socket
StandardError=journal
ExecStart=/usr/bin/python3 -IB /usr/local/lib/pihole-group-pause/reload.py /var/log/pihole/FTL.log --container pihole
TimeoutStartSec=30
RuntimeMaxSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
