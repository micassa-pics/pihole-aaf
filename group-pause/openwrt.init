#!/bin/sh /etc/rc.common
START=99
STOP=04
USE_PROCD=1

stack=/opt/docker/stacks/pihole
gravity=$stack/gravity
runtime=/var/run/pihole-pause
state=/opt/docker/pihole-pause-state
lib=/usr/lib/pihole-pause

start_service() {
    [ -f "$gravity/gravity.db" ] && [ ! -L "$gravity/gravity.db" ] || return 1
    local owner group
    local ids
    ids=$(python3 -c 'import os,sys; s=os.stat(sys.argv[1]); print(s.st_uid,s.st_gid)' "$gravity/gravity.db") || return 1
    owner=${ids% *}
    group=${ids#* }
    [ "$owner" != 0 ] && [ "$group" != 0 ] || return 1
    mkdir -p "$runtime/root" "$runtime/socket" "$state" || return 1
    chown "0:$group" "$runtime" && chmod 0750 "$runtime" || return 1
    chown "$owner:$group" "$state" && chmod 0700 "$state" || return 1
    chown "0:$group" "$runtime/socket" && chmod 0750 "$runtime/socket" || return 1

    procd_open_instance reload
    procd_set_param command /usr/bin/socat "UNIX-LISTEN:$runtime/socket/reload.sock,unlink-early,fork,max-children=1,mode=0600,uid=$owner" "EXEC:$lib/reload"
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance timer
    procd_set_param command /usr/bin/python3 -IB "$lib/launch.py" "$owner" "$group" "$gravity" "$state" "$runtime"
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}

